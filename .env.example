# agentscop-platform 环境变量模板。
# 复制为 .env 后按需修改；python-dotenv 由官方框架加载（load_env_file）。
# 全部变量均有默认值 —— 不创建 .env 也能零依赖启动（见「本地启动」）。

# ── 部署模式（server/paths.py）──────────────────────────────────
# 存储后端：sqlite（默认，单机零依赖）| redis（生产/容器）
AGENTS_STORAGE=sqlite
# 向量库：path（默认，进程内本地文件库 data/qdrant_data）| url（Qdrant 服务）
AGENTS_QDRANT_MODE=path
# url 模式下的 Qdrant 地址（设置后自动切换 url 模式）
#AGENTS_QDRANT_URL=http://localhost:6333

# ── 路径覆盖 ─────────────────────────────────────────────────────
# SQLite 数据库文件（默认 data/agentscope.db）
#AGENTS_DB_PATH=data/agentscope.db

# ── 服务端口与 TLS（server/app.py / main.py）─────────────────────
# 本地 start-dev/start-all 默认 8020（本机 127.0.0.1:8000 常被 IDE 占用）；
# 容器/服务器部署为 8000。此处不设则跟随启动脚本。
#AGENTS_BACKEND_PORT=8020
# 单端口 HTTPS（自签证书）：两者都设置时 uvicorn 以 HTTPS 监听
#AGENTS_SSL_CERTFILE=deploy/certs/fullchain.pem
#AGENTS_SSL_KEYFILE=deploy/certs/privkey.pem
# Dev 前端代理（start-dev.ps1 自动设置；设置后非 API 路径反代到 Vite）
#AGENTS_DEV_FRONTEND_URL=http://localhost:5173
# 热重载（Windows 默认关；容器里设 0）
#AGENTS_RELOAD=0

# ── Redis（AGENTS_STORAGE=redis 时使用）──────────────────────────
AGENTS_REDIS_HOST=localhost
AGENTS_REDIS_PORT=6379

# ── 角色表（server/roles_store.py）───────────────────────────────
# redis | file（默认跟随 AGENTS_STORAGE：sqlite→file、redis→redis）
#AGENTS_ROLES_STORE=file
# file 模式用户表路径（默认 config/roles.json）
#AGENTS_ROLES_FILE=config/roles.json
# 角色表变更审计日志（默认 config/roles_audit.log）
#AGENTS_ROLES_AUDIT=config/roles_audit.log
# 首启种子：admin1:pw1,admin2:pw2,...（明文，导入时即哈希）。
# 仅在 config/roles.json 不存在时生效；两者皆无则认证关闭
# （身份回退请求头），建议至少配置一个管理员。
#AGENTS_USERS=admin:YourStrongPassword

# ── embedding（LocalBgeCredential，server/model_policy.py）───────
# OpenAI 兼容 /v1/embeddings 端点：TEI 容器（默认）或 embed_server.py
#TEI_BASE_URL=http://localhost:19556/v1
#TEI_API_KEY=tei

# ── 渠道（飞书/钉钉/Discord，按需）───────────────────────────────
#FEISHU_APP_ID=...
#FEISHU_APP_SECRET=...
#DINGTALK_CLIENT_ID=...
#DINGTALK_CLIENT_SECRET=...
#DISCORD_BOT_TOKEN=...

# ── MCP / 技能市场 ────────────────────────────────────────────────
# 高德地图 MCP（default_mcps 可选项）
#AMAP_API_KEY=...
# ClawHub 技能市场令牌（可选）
#CLAWHUB_API_TOKEN=...

# ── 长期记忆语义化整理（可选，AgenticMemoryMiddleware）────────────
#EMBEDDING_API_KEY=...
#EMBEDDING_BASE_URL=...
