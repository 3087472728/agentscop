# 云效个人访问令牌（在云效工作台 → 个人设置 → 个人访问令牌 中创建）
# 权限勾选：项目协作 相关权限
YUNXIAO_TOKEN=pt-your_token_here

# 云效服务接入点域名（标准版: openapi-rdc.aliyuncs.com）
YUNXIAO_DOMAIN=openapi-rdc.aliyuncs.com

# 云效组织 ID（在组织管理后台 → 基本信息 页面获取）
YUNXIAO_ORGANIZATION_ID=your_org_id

# 云效默认项目 ID（可选，批量创建任务时如果文件未指定则使用此值）
# 各项目独立 ID 见下方
YUNXIAO_PROJECT_ID=your_project_id

# 本溪燃气监测管理平台
YUNXIAO_PROJECT_ID_CCULL=your_project_id

# 沈阳交通执法项目（cctef）
YUNXIAO_PROJECT_ID_CCTEF=your_project_id

# 辽宁省燃气平台
YUNXIAO_PROJECT_ID_CCULL_LN=your_project_id

# 千问 API Key（可选，AI 辅助功能需要）
QWEN_API_KEY=your_qwen_api_key
