{
  "_c": "通用骨架模板。复制后按需裁剪; 每类 op 的参数见 _specs/README.md; 固定套路优先用 block 区块(_bindrun.py blocks 查清单)。",
  "doc_name": "XX(在此写文书名)",
  "template_id": "__TID__",
  "backup_tag": "自定义简称",
  "auth": "cache",
  "refresh_meta": true,
  "asserts": ["必须存在的锚点文字1", "锚点文字2"],
  "steps": [
    { "_c": "案号 serial(清残留散字, 右对齐)", "op": "block", "name": "case_no", "args": { "placeholder": "辽X交XX字" } },
    { "_c": "时间起止行: 整行替换为 起(DATETIME)+至+止(DATETIME)", "op": "block", "name": "time_range",
      "args": { "anchor": "检查（勘验）时间：", "start_field": "startDate", "end_field": "endDate", "with_time": true } },
    { "_c": "执法人员N行(姓名+证号)", "op": "block", "name": "officer_lines", "args": { "count": 2 } },
    { "_c": "精简式签名行(标签+signature+日期)", "op": "block", "name": "signature_line", "args": { "label": "行政执法人员：" } },
    { "_c": "印章区(机关名继承字体+stamp+日期)", "op": "block", "name": "stamp_date",
      "args": { "agency": "交通运输执法部门（印章）", "tr": 11, "col": 1 } },
    { "_c": "备注: 保留标签+未绑定多行文本", "op": "block", "name": "remark_textarea", "args": { "anchor": "备注：" } },
    { "_c": "当事人区槽位: 按角色前缀路由字段(铁律2)", "op": "block", "name": "party_slot",
      "args": { "anchor": "性别：", "occ": 2, "role": "agent", "fallback": "unbound" } },
    { "_c": "年月日占位文字→date 控件(完整替代)", "op": "block", "name": "ymd_replace", "args": { "bind": "systemDate", "occ": 1 } },
    { "_c": "锚点后空位放1个控件", "op": "bind_after", "anchor": "案由：", "ctrl": { "meta": "violationCaseCause" } },
    { "_c": "锚点后空位放多个控件(依次填空位)", "op": "bind_after", "anchor": "受送达人：",
      "ctrl": [{ "meta": "personName" }, { "meta": "companyName" }] },
    { "_c": "第N次出现的锚点后绑定", "op": "bind_occurrence", "anchor": "性别：", "occ": 2, "ctrl": { "meta": "personGender" } },
    { "_c": "整行替换(keep_anchor=true保留标签文字)", "op": "replace_line", "anchor": "处罚机关：",
      "parts": [{ "text": "处罚机关：", "size": 16 }, { "meta": "agency" }, { "newline": true }], "keep_anchor": false },
    { "_c": "区间替换(起锚到止锚整段重建, 保留止锚)", "op": "replace_range", "start_anchor": "当事人基本情况：",
      "end_anchor": "以上内容", "keep_end": true, "parts": [] },
    { "_c": "改文字保留样式", "op": "set_text", "anchor": "旧文字", "text": "新文字" },
    { "_c": "清锚点后N个元素(案号散字)", "op": "clear_after", "anchor": "案号：", "count": 3 },
    { "_c": "表格单元格填控件", "op": "table_cell", "tr": 1, "col": 1,
      "parts": [{ "meta": "personName" }, { "meta": "companyName" }] },
    { "_c": "表格单元格断言", "op": "table_assert", "tr": 1, "col": 1, "contains": "受送达人" },
    { "_c": "直调 BindKit 方法", "op": "kit", "method": "split_checkboxes", "args": {} }
  ],
  "split_checkboxes": true,
  "clean_date_residual": true,
  "underlines": { "personName": 414 },
  "fit_underlines": true,
  "font_map": [["一、", "宋体", 18, true, false]],
  "margins": {},
  "verify": {
    "expect_min_bindings": 5,
    "expect_bind": ["personName"]
  }
}
