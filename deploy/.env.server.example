# agentscop-platform 服务器 .env 模板（阿里云 ACR 链路，新栈 6020）。
# 复制为同目录 .env 后逐项填写；只存在服务器上，chmod 600，绝不入库。
# 命名空间 <ns> 按你在 ACR 控制台实际创建的填写。

# ══ 镜像（必填，全部走 ACR 公网域名）══════════════════════════════
AGENTS_IMAGE=crpi-d92le52k5f114023.cn-hangzhou.personal.cr.aliyuncs.com/<ns>/agentscop-platform:<tag>
AGENTS_IMAGE_REDIS=crpi-d92le52k5f114023.cn-hangzhou.personal.cr.aliyuncs.com/<ns>/redis:7
AGENTS_IMAGE_QDRANT=crpi-d92le52k5f114023.cn-hangzhou.personal.cr.aliyuncs.com/<ns>/qdrant:v1.19.1
AGENTS_IMAGE_TEI=crpi-d92le52k5f114023.cn-hangzhou.personal.cr.aliyuncs.com/<ns>/tei:cpu-1.8

# ══ 端口（6000 段，避开 8005 公司栈 / 8020 旧服务）════════════════
AGENTS_BACKEND_PORT=6020

# ══ 服务拓扑（compose 内部 DNS，勿改服务名）═══════════════════════
AGENTS_STORAGE=redis
AGENTS_ROLES_STORE=redis
# 注意：app.py 里无前缀 REDIS_HOST 会覆盖 AGENTS_REDIS_HOST，两个都设
REDIS_HOST=redis
AGENTS_REDIS_HOST=redis
AGENTS_REDIS_PORT=6379
AGENTS_QDRANT_MODE=url
AGENTS_QDRANT_URL=http://qdrant:6333
TEI_BASE_URL=http://tei:80/v1
AGENTS_RELOAD=0

# ══ TLS（自签名单端口 HTTPS）══════════════════════════════════════
AGENTS_SSL_CERTFILE=/app/certs/cert.pem
AGENTS_SSL_KEYFILE=/app/certs/key.pem
# 管理脚本绕过自签名证书校验
AGENTS_INSECURE_TLS=1

# ══ TEI embedding 权重（宿主机路径，只读挂载）═════════════════════
# 权重不进镜像；若与 agentscope-v2 栈共用同一份宿主机权重则无需改动
AGENTS_TEI_WEIGHTS_HOST_DIR=/home/agentrunner/models
AGENTS_TEI_MODEL_ID=/data/BAAI--bge-small-zh-v1.5

# ══ 用户与凭据（按需填写）═════════════════════════════════════════
# 首启种子管理员（仅 config/roles.json 不存在时生效），格式 user:pass 逗号分隔
AGENTS_USERS=admin:ChangeMeStrongPassword
# 智谱开放平台（PDF 图表视觉解析等用；ZAI_MODEL 默认 glm-5.3-flash）
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 智能体归属/默认共享策略（可选）
#AGENTS_OWNER=admin
#AGENTS_DEFAULT_SHARE=
